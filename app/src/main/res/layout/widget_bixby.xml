<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <TextView android:id="@+id/w_type" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Type to Bixby…" android:textColor="#666666" android:textSize="15sp"
        android:padding="10dp"/>
    <TextView android:id="@+id/w_talk" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🎤" android:textSize="22sp" android:padding="10dp"/>
    <TextView android:id="@+id/w_history" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🕘" android:textSize="22sp" android:padding="10dp"/>
</LinearLayout>
